${BOLD}CONFIG${RESET}
    Global:  ~/.muxtree/config          (worktree_dir, terminal, copy_files, setup_commands)
    Project: .muxtree in repo root      (overrides global settings)
    Env:     MUXTREE_CONFIG_DIR=/path    (override global config dir)
"
}

# ── Main Dispatch ─────────────────────────────────────────────────────────────

main() {
    local cmd="${1:-help}"
    shift 2>/dev/null || true

    case "$cmd" in
        init)       cmd_init "$@" ;;
        config)     cmd_config "$@" ;;
        new)        cmd_new "$@" ;;
        list|ls)    cmd_list "$@" ;;
        status|top) cmd_status "$@" ;;
        delete|rm)  cmd_delete "$@" ;;
        sessions|s) cmd_sessions "$@" ;;
        help|-h|--help) cmd_help ;;
        version|-v|--version) echo "muxtree v$VERSION" ;;
        *)          die "Unknown command: $cmd. Run 'muxtree help' for usage." ;;
    esac
}

# Dispatch only when executed directly. When sourced (test.sh), the sourcing
# script's own arguments must not be run as muxtree commands.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
