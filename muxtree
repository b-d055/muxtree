#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# muxtree — Tmux Worktree Session Manager
# Create and manage git worktrees + tmux sessions for AI coding agents
# ─────────────────────────────────────────────────────────────────────────────

VERSION="1.2.0"
CONFIG_DIR="${MUXTREE_CONFIG_DIR:-$HOME/.muxtree}"
CONFIG_FILE="$CONFIG_DIR/config"

# ── Defaults ──────────────────────────────────────────────────────────────────
DEFAULT_WORKTREE_DIR="$HOME/worktrees"
DEFAULT_TERMINAL="terminal"  # terminal | iterm2
DEFAULT_COPY_FILES=""
DEFAULT_SETUP_COMMANDS=""

# ── Colors ────────────────────────────────────────────────────────────────────
# ANSI-C quoted, so these hold real ESC characters rather than the 5-character
# sequence \033. `echo -e` renders both identically, but printf '%s' -- used by
# the status pane -- only renders the real thing.
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
RESET=$'\033[0m'

if [[ ! -t 1 ]]; then
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' BOLD='' DIM='' RESET=''
fi

# ── Helpers ───────────────────────────────────────────────────────────────────

logo() {
    cat <<'LOGO'
                       _
  _ __ ___  _   ___  _| |_ _ __ ___  ___
 | '_ ` _ \| | | \ \/ / __| '__/ _ \/ _ \
 | | | | | | |_| |>  <| |_| | |  __/  __/
 |_| |_| |_|\__,_/_/\_\\__|_|  \___|\___|
LOGO
    echo -e "  ${DIM}Tmux Worktree Session Manager v$VERSION${RESET}"
}

info()    { echo -e "${BLUE}▸${RESET} $*"; }
success() { echo -e "${GREEN}✓${RESET} $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET} $*"; }
error()   { echo -e "${RED}✗${RESET} $*" >&2; }
die()     { error "$@"; exit 1; }

_parse_config() {
    local file="$1"
    while IFS='=' read -r key value; do
        # Trim whitespace (pure bash, no xargs)
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"

        # setup_commands intentionally contains shell commands; only reject
        # command substitution (backticks, $(...)) to prevent config injection
        if [[ "$key" == "setup_commands" ]]; then
            if [[ "$value" =~ [\`] ]] || [[ "$value" == *'$('* ]]; then
                warn "Ignoring suspicious value for '$key' in $file"
                continue
            fi
        elif [[ "$value" =~ [\`\$\;\|\&] ]] || [[ "$value" == *'$('* ]]; then
            warn "Ignoring suspicious value for '$key' in $file"
            continue
        fi

        case "$key" in
            worktree_dir)    WORKTREE_DIR="$value" ;;
            terminal)        TERMINAL="$value" ;;
            copy_files)      COPY_FILES="$value" ;;
            setup_commands)  SETUP_COMMANDS="$value" ;;
        esac
    done < <(grep -E '^[a-z_]+=' "$file")
}

load_config() {
    WORKTREE_DIR="$DEFAULT_WORKTREE_DIR"
    TERMINAL="$DEFAULT_TERMINAL"
    COPY_FILES="$DEFAULT_COPY_FILES"
    SETUP_COMMANDS="$DEFAULT_SETUP_COMMANDS"
    ACTIVE_CONFIG="none"

    # 1. Load global config as base
    if [[ -f "$CONFIG_FILE" ]]; then
        _parse_config "$CONFIG_FILE"
        ACTIVE_CONFIG="global"
    fi

    # 2. Override with project-local config if inside a git repo
    local repo_root
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    LOCAL_CONFIG_FILE="${repo_root:+$repo_root/.muxtree}"

    if [[ -n "$LOCAL_CONFIG_FILE" && -f "$LOCAL_CONFIG_FILE" ]]; then
        _parse_config "$LOCAL_CONFIG_FILE"
        ACTIVE_CONFIG="local"
    fi

    # Expand tilde
    WORKTREE_DIR="${WORKTREE_DIR/#\~/$HOME}"
}

ensure_git_repo() {
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        die "Not inside a git repository. Run muxtree from within your repo."
    fi
}

get_repo_root() {
    git rev-parse --show-toplevel
}

get_repo_name() {
    basename "$(get_repo_root)"
}

get_main_branch() {
    # Try to find main/master branch
    local main_ref
    main_ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || true)
    if [[ -z "$main_ref" ]]; then
        # Fallback: check for common names
        for branch in main master; do
            if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
                main_ref="$branch"
                break
            fi
        done
    fi
    echo "${main_ref:-main}"
}

# Resolve <branch> to a remote-tracking ref for `new --checkout`. Prefers
# origin; otherwise the first remote that has the branch. Sets the variable
# named by $2 to a full refs/remotes/<remote>/<branch> ref, or "" if none.
# Uses show-ref per remote (not a glob) so branch names with slashes work.
_resolve_remote_branch() {
    local branch="$1" _outvar="$2" r result=""
    if git show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null; then
        result="refs/remotes/origin/$branch"
    else
        while IFS= read -r r; do
            [[ -n "$r" ]] || continue
            if git show-ref --verify --quiet "refs/remotes/$r/$branch" 2>/dev/null; then
                result="refs/remotes/$r/$branch"
                break
            fi
        done < <(git remote)
    fi
    printf -v "$_outvar" '%s' "$result"
}

worktree_path() {
    local repo_name="$1"
    local branch="$2"
    # Sanitize branch name for safe filesystem use (strip traversal, special chars)
    local safe_branch="${branch//[^a-zA-Z0-9._-]/-}"
    safe_branch="${safe_branch#-}"  # strip leading dash
    echo "$WORKTREE_DIR/$repo_name/$safe_branch"
}

session_prefix() {
    local repo_name="$1"
    local branch="$2"
    # Allowlist: replace anything not alphanumeric, underscore, or dash
    local clean_branch="${branch//[^a-zA-Z0-9_-]/-}"
    clean_branch="${clean_branch#-}"  # strip leading dash
    echo "${repo_name}_${clean_branch}"
}

has_tmux_session() {
    # '=' forces an exact-name match: a bare -t prefix-matches, so with
    # sessions "repo_fix" and "repo_fix-bug" the former would answer for both.
    tmux has-session -t "=$1" 2>/dev/null
}

# Attach to a session, switching clients when already inside tmux -- a bare
# `tmux attach` from within tmux fails with "sessions should be nested with care".
_attach_session() {
    local sess="$1"
    if [[ -n "${TMUX:-}" ]]; then
        exec tmux switch-client -t "$sess"
    else
        exec tmux attach -t "$sess"
    fi
}

# ── Worktree introspection (shared by list, status, delete, sessions) ─────────

# Managed worktrees under $WORKTREE_DIR base $1, one per line: "<dir>\t<branch>".
# Detached HEADs are emitted with branch "(detached)" -- callers display them;
# hiding them would make a worktree with a live agent vanish from view.
_managed_worktrees() {
    local wt_base="$1" l wt_dir="" branch=""
    # --porcelain: unambiguous (paths with spaces, branch names with brackets),
    # and reports detached HEADs explicitly.
    while IFS= read -r l || [[ -n "$l" ]]; do
        case "$l" in
            'worktree '*) wt_dir="${l#worktree }"; branch="" ; continue ;;
            'branch '*)   branch="${l#branch refs/heads/}" ; continue ;;
            'detached')   branch="(detached)" ; continue ;;
            '') ;;
            *) continue ;;
        esac

        # blank line = end of one worktree record
        [[ -n "$wt_dir" && -n "$branch" ]] || { wt_dir=""; continue; }
        [[ "$wt_dir" == "$wt_base"/* ]] || { wt_dir=""; continue; }

        printf '%s\t%s\n' "$wt_dir" "$branch"
        wt_dir=""
    done < <(git worktree list --porcelain; printf '\n')
}

# Changed-file count and +/- for one worktree, in two git calls.
# Sets G_FILES, G_INS, G_DEL. Untracked files count toward G_FILES (they are
# real changes) but not toward +/-, which is what `git diff` can see.
# -uall so an untracked directory counts as its files, not as one entry.
# `git diff HEAD` already includes staged changes -- do not add --cached on top.
_git_stats() {
    local wt="$1" l short parts i
    G_FILES=0; G_INS=0; G_DEL=0

    while IFS= read -r l; do
        [[ -z "$l" ]] || G_FILES=$(( G_FILES + 1 ))
    done < <(git -C "$wt" status --porcelain=v1 -uall 2>/dev/null)

    short="$(git -C "$wt" diff --shortstat HEAD 2>/dev/null || true)"
    [[ -n "$short" ]] || return 0

    # " 3 files changed, 19 insertions(+), 23 deletions(-)"
    read -ra parts <<< "$short"
    for (( i = 1; i < ${#parts[@]}; i++ )); do
        case "${parts[$i]}" in
            insertion*) G_INS="${parts[$(( i - 1 ))]}" ;;
            deletion*)  G_DEL="${parts[$(( i - 1 ))]}" ;;
        esac
    done
}

# The tmux session for a worktree. muxtree names sessions after the branch at
# creation time, but a branch can be renamed or checked out elsewhere later --
# the worktree *directory* is the stable key, so prefer it and fall back.
_resolve_session() {
    local repo_name="$1" wt_dir="$2" branch="$3" cand
    cand="$(session_prefix "$repo_name" "${wt_dir##*/}")"
    if has_tmux_session "$cand"; then
        printf '%s' "$cand"; return 0
    fi
    # A detached HEAD has no branch to name a session after -- the worktree
    # directory is all there is.
    if [[ "$branch" == "(detached)" ]]; then
        printf '%s' "$cand"; return 0
    fi
    session_prefix "$repo_name" "$branch"
}

_build_run_cmd() {
    local run_cmd="$1"
    local prompt="${2:-}"

    if [[ -z "$prompt" ]]; then
        echo "$run_cmd"
        return
    fi

    # Escape single quotes in prompt for shell safety
    local escaped="${prompt//\'/\'\\\'\'}"
    case "$run_cmd" in
        claude) echo "claude '${escaped}'" ;;
        codex)  echo "codex '${escaped}'" ;;
    esac
}

# ── Config Management ─────────────────────────────────────────────────────────

cmd_init() {
    logo
    echo ""

    local local_mode=false
    [[ "${1:-}" == "--local" || "${1:-}" == "-l" ]] && local_mode=true

    if $local_mode; then
        ensure_git_repo
        local repo_root
        repo_root="$(get_repo_root)"
        local target_file="$repo_root/.muxtree"

        if [[ -f "$target_file" ]]; then
            warn "Project config already exists at $target_file"
            echo ""
            cat "$target_file"
            echo ""
            read -rp "Overwrite? (y/N) " confirm
            [[ "$confirm" =~ ^[Yy]$ ]] || return 0
        fi

        echo ""
        info "Enter files to copy into new worktrees for this project (relative to repo root)."
        info "Comma-separated, e.g.: .env,.env.local,CLAUDE.md"
        read -rp "Files to copy: " input_files

        echo ""
        info "Enter commands to run in the dev window when a new worktree is created."
        info "Comma-separated, e.g.: npm install,npm run build"
        read -rp "Setup commands: " input_setup

        cat > "$target_file" <<EOF
# muxtree project config
# Generated on $(date)

# Files to copy from repo root into new worktrees (comma-separated, relative to repo root)
# Supports glob patterns and directories
copy_files=$input_files

# Commands to run in the dev window when a new worktree is created (comma-separated)
# Chained with && so execution stops on first failure
setup_commands=$input_setup
EOF

        success "Project config written to $target_file"
        echo ""
        cat "$target_file"
    else
        if [[ -f "$CONFIG_FILE" ]]; then
            warn "Config already exists at $CONFIG_FILE"
            echo ""
            cat "$CONFIG_FILE"
            echo ""
            read -rp "Overwrite? (y/N) " confirm
            [[ "$confirm" =~ ^[Yy]$ ]] || return 0
        fi

        mkdir -p "$CONFIG_DIR"

        echo ""
        read -rp "Worktree base directory [$DEFAULT_WORKTREE_DIR]: " input_dir
        local wt_dir="${input_dir:-$DEFAULT_WORKTREE_DIR}"

        read -rp "Terminal app (terminal/iterm2) [$DEFAULT_TERMINAL]: " input_term
        local term="${input_term:-$DEFAULT_TERMINAL}"

        echo ""
        info "Enter files to copy into new worktrees (relative to repo root)."
        info "Comma-separated, e.g.: .env,.env.local,CLAUDE.md"
        read -rp "Files to copy: " input_files

        echo ""
        info "Enter commands to run in the dev window when a new worktree is created."
        info "Comma-separated, e.g.: npm install,npm run build"
        read -rp "Setup commands: " input_setup

        cat > "$CONFIG_FILE" <<EOF
# muxtree configuration
# Generated on $(date)

# Base directory for worktrees
worktree_dir=$wt_dir

# Terminal app: terminal | iterm2
terminal=$term

# Files to copy from repo root into new worktrees (comma-separated, relative to repo root)
# Supports glob patterns and directories
copy_files=$input_files

# Commands to run in the dev window when a new worktree is created (comma-separated)
# Chained with && so execution stops on first failure
setup_commands=$input_setup
EOF

        success "Config written to $CONFIG_FILE"
        echo ""
        cat "$CONFIG_FILE"
    fi
}

cmd_config() {
    load_config

    local has_any=false

    if [[ -f "$CONFIG_FILE" ]]; then
        has_any=true
        echo -e "${BOLD}Global config:${RESET} $CONFIG_FILE"
        echo "─────────────────────────────────"
        cat "$CONFIG_FILE"
        echo ""
    fi

    if [[ -n "${LOCAL_CONFIG_FILE:-}" && -f "$LOCAL_CONFIG_FILE" ]]; then
        has_any=true
        echo -e "${BOLD}Project config:${RESET} $LOCAL_CONFIG_FILE ${GREEN}(active)${RESET}"
        echo "─────────────────────────────────"
        cat "$LOCAL_CONFIG_FILE"
        echo ""
    elif [[ "$has_any" == true ]]; then
        echo -e "${DIM}No project config. Use ${RESET}${BOLD}muxtree init --local${RESET}${DIM} to create one.${RESET}"
    fi

    if ! $has_any; then
        warn "No config found. Run ${BOLD}muxtree init${RESET} to create one."
        return 1
    fi
}

# ── New Worktree ──────────────────────────────────────────────────────────────

cmd_new() {
    local branch=""
    local base_branch=""
    local run_cmd=""
    local prompt=""
    local bg=false
    local checkout=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from)          base_branch="$2"; shift 2 ;;
            --checkout|-c)   checkout=true; shift ;;
            --run)           run_cmd="$2"; shift 2 ;;
            --prompt|-p)     prompt="$2"; shift 2 ;;
            --bg)            bg=true; shift ;;
            -*)              die "Unknown option: $1" ;;
            *)               branch="$1"; shift ;;
        esac
    done

    [[ -n "$branch" ]] || die "Usage: muxtree new <branch-name> [--from <base-branch>] [--checkout] [--run claude|codex] [--prompt \"...\"] [--bg]"

    # --checkout adopts an existing branch; --from picks a base for a new one.
    if [[ "$checkout" == "true" && -n "$base_branch" ]]; then
        die "--checkout and --from are mutually exclusive: --checkout adopts an existing branch, --from creates a new one from a base."
    fi

    # Validate --run command if provided
    if [[ -n "$run_cmd" ]]; then
        case "$run_cmd" in
            claude|codex) ;;
            *) die "Invalid --run command: '$run_cmd'. Allowed: claude, codex" ;;
        esac
    fi

    # Validate --prompt requires --run
    if [[ -n "$prompt" && -z "$run_cmd" ]]; then
        die "--prompt requires --run <claude|codex>"
    fi

    # Build full command with prompt
    if [[ -n "$prompt" ]]; then
        run_cmd="$(_build_run_cmd "$run_cmd" "$prompt")"
    fi

    ensure_git_repo
    load_config

    local repo_root repo_name wt_path
    repo_root="$(get_repo_root)"
    repo_name="$(get_repo_name)"
    wt_path="$(worktree_path "$repo_name" "$branch")"

    if [[ -d "$wt_path" ]]; then
        die "Worktree already exists at $wt_path"
    fi

    mkdir -p "$(dirname "$wt_path")"

    if [[ "$checkout" == "true" ]]; then
        # 1. Check out an existing branch (local first, then a remote) so commits
        #    push back to the real branch -- e.g. reviewing/contributing to a PR.
        local remote_ref=""
        if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
            info "Creating worktree at ${CYAN}$wt_path${RESET}"
            git worktree add "$wt_path" "$branch"
            success "Worktree created (checked out existing branch ${CYAN}$branch${RESET})"
        else
            _resolve_remote_branch "$branch" remote_ref
            if [[ -z "$remote_ref" ]]; then
                info "Branch not found locally; fetching from remotes..."
                git fetch --all --quiet 2>/dev/null || true
                _resolve_remote_branch "$branch" remote_ref
            fi
            [[ -n "$remote_ref" ]] || \
                die "Branch '$branch' not found locally or on any remote. Run 'git fetch' or check the name."
            info "Creating worktree at ${CYAN}$wt_path${RESET}"
            git worktree add --track -b "$branch" "$wt_path" "$remote_ref"
            success "Worktree created (tracking ${DIM}${remote_ref#refs/remotes/}${RESET} as ${CYAN}$branch${RESET})"
        fi
    else
        base_branch="${base_branch:-$(get_main_branch)}"

        # Validate base branch exists
        if ! git show-ref --verify --quiet "refs/heads/$base_branch" 2>/dev/null && \
           ! git show-ref --verify --quiet "refs/remotes/origin/$base_branch" 2>/dev/null; then
            die "Base branch '$base_branch' does not exist."
        fi

        # Check if branch already exists
        if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
            die "Branch '$branch' already exists. Use --checkout to adopt it, a different name, or delete it first."
        fi

        # 1. Create worktree with new branch
        info "Creating worktree at ${CYAN}$wt_path${RESET}"
        git worktree add -b "$branch" "$wt_path" "$base_branch"
        success "Worktree created (branch ${CYAN}$branch${RESET} from ${DIM}$base_branch${RESET})"
    fi

    # 2. Copy config files
    if [[ -n "$COPY_FILES" ]]; then
        info "Copying config files..."
        IFS=',' read -ra files <<< "$COPY_FILES"
        for file in "${files[@]}"; do
            file="${file#"${file%%[![:space:]]*}"}"
            file="${file%"${file##*[![:space:]]}"}"
            [[ -n "$file" ]] || continue

            # Safe glob expansion with nullglob
            local matches
            local _old_nullglob
            _old_nullglob=$(shopt -p nullglob || true)
            shopt -s nullglob
            matches=( "$repo_root"/$file )
            eval "$_old_nullglob"

            if (( ${#matches[@]} == 0 )); then
                warn "  Not found: ${DIM}$file${RESET}"
                continue
            fi

            for match in "${matches[@]}"; do
                if [[ -e "$match" ]]; then
                    local rel="${match#"$repo_root"/}"
                    local dest="$wt_path/$rel"
                    mkdir -p -- "$(dirname -- "$dest")"
                    cp -a -- "$match" "$dest"
                    success "  Copied ${DIM}$rel${RESET}"
                fi
            done
        done
    fi

    # 3. Launch tmux sessions
    _launch_sessions "$repo_name" "$branch" "$wt_path" "$run_cmd" "$bg"

    # 4. Run setup commands in dev window
    if [[ -n "$SETUP_COMMANDS" ]]; then
        local sess
        sess="$(session_prefix "$repo_name" "$branch")"
        info "Running setup commands in dev window..."
        IFS=',' read -ra cmds <<< "$SETUP_COMMANDS"
        local chained=""
        for cmd in "${cmds[@]}"; do
            cmd="${cmd#"${cmd%%[![:space:]]*}"}"
            cmd="${cmd%"${cmd##*[![:space:]]}"}"
            [[ -n "$cmd" ]] || continue
            if [[ -n "$chained" ]]; then
                chained="$chained && $cmd"
            else
                chained="$cmd"
            fi
            success "  ${DIM}$cmd${RESET}"
        done
        if [[ -n "$chained" ]]; then
            tmux send-keys -t "$sess:dev" "$chained" Enter
        fi
    fi

    echo ""
    success "Ready! Worktree: ${CYAN}$wt_path${RESET}"
    echo -e "  Session: ${BOLD}$(session_prefix "$repo_name" "$branch")${RESET} (windows: dev, agent)"
}

_launch_sessions() {
    local repo_name="$1"
    local branch="$2"
    local wt_path="$3"
    local run_cmd="${4:-}"
    local bg="${5:-false}"

    local sess
    sess="$(session_prefix "$repo_name" "$branch")"

    info "Creating tmux session..."

    # Create session with dev window
    tmux new-session -d -s "$sess" -c "$wt_path"
    tmux rename-window -t "$sess:0" "dev"

    # Add agent window
    tmux new-window -t "$sess" -n "agent" -c "$wt_path"

    # Run command in agent window if requested
    if [[ -n "$run_cmd" ]]; then
        tmux send-keys -t "$sess:agent" "$run_cmd" Enter
    fi

    # Select dev window as default
    tmux select-window -t "$sess:dev"

    success "  Created session ${BOLD}$sess${RESET} (windows: dev, agent)"

    # Open terminal window (unless --bg)
    if [[ "$bg" != "true" ]]; then
        _open_terminal "$sess"
    fi
}

_open_terminal() {
    local session="$1"

    # Escape double quotes and backslashes for safe AppleScript embedding
    local safe_session="${session//\\/\\\\}"
    safe_session="${safe_session//\"/\\\"}"

    case "$TERMINAL" in
        iterm2)
            osascript <<EOF 2>/dev/null || true
tell application "iTerm"
    activate
    create window with default profile
    tell current session of current window
        write text "tmux attach -t ${safe_session}"
    end tell
end tell
EOF
            ;;
        terminal|*)
            osascript <<EOF 2>/dev/null || true
tell application "Terminal"
    activate
    do script "tmux attach -t ${safe_session}"
end tell
EOF
            ;;
    esac
}

# ── List Worktrees ────────────────────────────────────────────────────────────

cmd_list() {
    ensure_git_repo
    load_config

    local repo_name
    repo_name="$(get_repo_name)"
    local wt_base="$WORKTREE_DIR/$repo_name"

    echo -e "${BOLD}Worktrees for ${CYAN}$repo_name${RESET}"
    echo "════════════════════════════════════════════════════════════════"

    if [[ ! -d "$wt_base" ]]; then
        info "No worktrees found. Use ${BOLD}muxtree new <branch>${RESET} to create one."
        return 0
    fi

    local found=false

    local wt_dir branch_name sess diff_stat sess_status
    while IFS=$'\t' read -r wt_dir branch_name; do
        found=true

        sess="$(_resolve_session "$repo_name" "$wt_dir" "$branch_name")"

        _git_stats "$wt_dir"
        diff_stat="${GREEN}+${G_INS}${RESET} ${RED}-${G_DEL}${RESET} ${DIM}${G_FILES}f${RESET}"

        if has_tmux_session "$sess"; then
            sess_status="${GREEN}●${RESET}"
        else
            sess_status="${DIM}○${RESET}"
        fi

        echo ""
        echo -e "  ${BOLD}${CYAN}$branch_name${RESET}  $diff_stat"
        echo -e "  ${DIM}$wt_dir${RESET}"
        echo -e "  Session: $sess_status $sess"

    done < <(_managed_worktrees "$wt_base")

    if ! $found; then
        info "No managed worktrees found. Use ${BOLD}muxtree new <branch>${RESET} to create one."
    fi

    echo ""
}

# ── Delete Worktree ───────────────────────────────────────────────────────────

cmd_delete() {
    local branch=""
    local force=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f) force=true; shift ;;
            -*)         die "Unknown option: $1" ;;
            *)          branch="$1"; shift ;;
        esac
    done

    [[ -n "$branch" ]] || die "Usage: muxtree delete <branch-name> [--force|-f]"

    ensure_git_repo
    load_config

    local repo_name wt_path
    repo_name="$(get_repo_name)"
    wt_path="$(worktree_path "$repo_name" "$branch")"

    if [[ ! -d "$wt_path" ]]; then
        die "Worktree not found: $wt_path"
    fi

    # Show diff stats before confirming
    _git_stats "$wt_path"

    echo ""
    echo -e "  Branch:    ${BOLD}$branch${RESET}"
    echo -e "  Path:      ${DIM}$wt_path${RESET}"
    echo -e "  Changes:   ${GREEN}+${G_INS}${RESET} ${RED}-${G_DEL}${RESET} (${G_FILES} files)"
    echo ""

    if ! $force; then
        warn "This will remove the worktree and delete the local branch."
        read -rp "Are you sure? (y/N) " confirm
        [[ "$confirm" =~ ^[Yy]$ ]] || { info "Cancelled."; return 0; }
    fi

    # Kill tmux sessions
    _kill_sessions "$repo_name" "$branch"

    # Remove worktree
    info "Removing worktree..."
    git worktree remove "$wt_path" --force 2>/dev/null || {
        warn "git worktree remove failed, cleaning up manually..."
        rm -rf -- "$wt_path"
        git worktree prune
    }
    success "Worktree removed"

    # Delete the branch
    info "Deleting branch ${CYAN}$branch${RESET}..."
    git branch -D "$branch" 2>/dev/null && success "Branch deleted" || warn "Branch may have already been deleted"

    # Clean up empty repo dir
    local repo_dir="$WORKTREE_DIR/$repo_name"
    if [[ -d "$repo_dir" ]]; then
        local _old_dotglob _old_nullglob_del
        _old_dotglob=$(shopt -p dotglob || true)
        _old_nullglob_del=$(shopt -p nullglob || true)
        shopt -s nullglob dotglob
        local _dir_files=("$repo_dir"/*)
        eval "$_old_dotglob"
        eval "$_old_nullglob_del"
        if (( ${#_dir_files[@]} == 0 )); then
            rmdir -- "$repo_dir" 2>/dev/null || true
        fi
    fi

    echo ""
    success "Done."
}

# ── Session Management ────────────────────────────────────────────────────────

cmd_sessions() {
    local action="${1:-}"
    local branch="${2:-}"
    local run_cmd=""
    local prompt=""
    local bg=false

    # Parse remaining args
    local extra_arg=""
    shift 2 2>/dev/null || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --run)       run_cmd="$2"; shift 2 ;;
            --prompt|-p) prompt="$2"; shift 2 ;;
            --bg)        bg=true; shift ;;
            -*)          die "Unknown option: $1" ;;
            *)           extra_arg="$1"; shift ;;
        esac
    done

    case "$action" in
        open|launch|start)
            [[ -n "$branch" ]] || die "Usage: muxtree sessions open <branch> [--run claude|codex] [--prompt \"...\"] [--bg]"
            if [[ -n "$run_cmd" ]]; then
                case "$run_cmd" in
                    claude|codex) ;;
                    *) die "Invalid --run command: '$run_cmd'. Allowed: claude, codex" ;;
                esac
            fi
            if [[ -n "$prompt" && -z "$run_cmd" ]]; then
                die "--prompt requires --run <claude|codex>"
            fi
            if [[ -n "$prompt" ]]; then
                run_cmd="$(_build_run_cmd "$run_cmd" "$prompt")"
            fi
            _sessions_open "$branch" "$run_cmd" "$bg"
            ;;
        close|kill|stop)
            [[ -n "$branch" ]] || die "Usage: muxtree sessions close <branch>"
            _sessions_close "$branch"
            ;;
        relaunch|restart)
            [[ -n "$branch" ]] || die "Usage: muxtree sessions relaunch <branch> [--run claude|codex] [--prompt \"...\"] [--bg]"
            if [[ -n "$run_cmd" ]]; then
                case "$run_cmd" in
                    claude|codex) ;;
                    *) die "Invalid --run command: '$run_cmd'. Allowed: claude, codex" ;;
                esac
            fi
            if [[ -n "$prompt" && -z "$run_cmd" ]]; then
                die "--prompt requires --run <claude|codex>"
            fi
            if [[ -n "$prompt" ]]; then
                run_cmd="$(_build_run_cmd "$run_cmd" "$prompt")"
            fi
            _sessions_close "$branch"
            _sessions_open "$branch" "$run_cmd" "$bg"
            ;;
        attach)
            [[ -n "$branch" ]] || die "Usage: muxtree sessions attach <branch> [dev|agent]"
            _sessions_attach "$branch" "${extra_arg:-}"
            ;;
        *)
            die "Usage: muxtree sessions <open|close|relaunch|attach> <branch> [--run claude|codex] [--bg]"
            ;;
    esac
}

_sessions_open() {
    local branch="$1"
    local run_cmd="$2"
    local bg="${3:-false}"

    ensure_git_repo
    load_config

    local repo_name wt_path
    repo_name="$(get_repo_name)"
    wt_path="$(worktree_path "$repo_name" "$branch")"

    [[ -d "$wt_path" ]] || die "Worktree not found: $wt_path"

    local sess
    sess="$(_resolve_session "$repo_name" "$wt_path" "$branch")"

    if has_tmux_session "$sess"; then
        info "Session $sess already exists, opening terminal window"
        _open_terminal "$sess"
    else
        # Create session with dev window
        tmux new-session -d -s "$sess" -c "$wt_path"
        tmux rename-window -t "$sess:0" "dev"

        # Add agent window
        tmux new-window -t "$sess" -n "agent" -c "$wt_path"

        # Run command in agent window if requested
        if [[ -n "$run_cmd" ]]; then
            tmux send-keys -t "$sess:agent" "$run_cmd" Enter
        fi

        # Select dev window as default
        tmux select-window -t "$sess:dev"

        success "Created session ${BOLD}$sess${RESET} (windows: dev, agent)"

        # Open terminal window (unless --bg)
        if [[ "$bg" != "true" ]]; then
            _open_terminal "$sess"
        fi
    fi
}

_sessions_close() {
    local branch="$1"

    ensure_git_repo
    load_config

    local repo_name
    repo_name="$(get_repo_name)"

    _kill_sessions "$repo_name" "$branch"
}

_sessions_attach() {
    local branch="$1"
    local window="${2:-}"

    ensure_git_repo
    load_config

    local repo_name sess
    repo_name="$(get_repo_name)"
    sess="$(_resolve_session "$repo_name" "$(worktree_path "$repo_name" "$branch")" "$branch")"

    if ! has_tmux_session "$sess"; then
        die "Session not found: $sess"
    fi

    # Select window if specified
    if [[ -n "$window" ]]; then
        case "$window" in
            dev|agent) tmux select-window -t "$sess:$window" ;;
            *) die "Unknown window: $window (use dev or agent)" ;;
        esac
    fi

    _attach_session "$sess"
}

_kill_sessions() {
    local repo_name="$1"
    local branch="$2"

    local sess
    sess="$(_resolve_session "$repo_name" "$(worktree_path "$repo_name" "$branch")" "$branch")"

    if has_tmux_session "$sess"; then
        tmux kill-session -t "$sess"
        success "Killed session ${BOLD}$sess${RESET}"
    fi
}

# ── Status Pane ───────────────────────────────────────────────────────────────

STATUS_DEFAULT_INTERVAL=2

# Listening ports change far more slowly than agent output, and lsof is the
# most expensive call in a frame -- refresh the port map at most this often.
PORTS_TTL=6

# Column widths (characters). Header pads and row pads both read these, and
# the fixed-row total is derived from them in _status_frame -- to resize a
# column, change it here and nowhere else.
W_BRANCH=22 W_AGENT=12 W_INS=6 W_DEL=6 W_FILES=4 W_PORTS=9 W_TERM=5
W_OUT_MIN=12

# ── Agent TUI markers ─────────────────────────────────────────────────────────
# These strings are agent TUI chrome and will drift between releases; they are
# the price of not requiring hooks. Verified against Claude Code 2.1.x and
# codex-cli 0.144.0 (fixtures in test.sh pin both). Both _is_chrome and
# _classify_pane read these tables -- a UI drift is fixed HERE, in one place.
#
# Each entry is a bash glob, matched unanchored against the whole pane text
# (state markers) or against one left-trimmed line (chrome patterns).
#
# Input: Claude Code renders a "❯ 1." selector with dialog trailers; Codex
# renders "› 1." (U+203A, a different glyph) with "Press enter to confirm/
# continue" trailers.
INPUT_MARKERS=(
    '*❯ 1.*' '*Esc to cancel · Tab to amend*' '*Enter to confirm*' '*\[y/n]*'
    '*› 1.*' '*Press enter to*'
)
# Both agents hint "esc to interrupt" while running (Codex: "• Working (2s •
# esc to interrupt)").
WORKING_MARKERS=('*esc to interrupt*' '*Esc to interrupt*')
# Claude Code idles with its hint bar; Codex idles showing its "› " composer
# (any line starting with it -- the second pattern covers a capture whose
# first line is the composer).
IDLE_MARKERS=(
    '*\? for shortcuts*' '*for agents*' '*to cycle*'
    $'*\n› *' '› *'
)
# Line-level chrome beyond the composer/hint-bar strings in IDLE_MARKERS: box
# rules, the input line, the feedback survey, the "✻ Worked for 30s" summary
# (glyph, word, "for", duration -- the leading char must be non-alphanumeric so
# prose like "I ran for 3 hours" is not swallowed), Claude's tool-output
# truncation notice, and Codex's "<model> <effort> · <cwd>" footer (the path
# after " · " may be absolute or ~-abbreviated).
CHROME_PATTERNS=(
    '───*' '╌╌╌*' '━━━*' '❯*'
    '*⏵⏵*' '*⏸*' '*new task\?*'
    '*How is Claude doing*' '1: Bad*'
    '[![:alnum:]] * for [0-9]*'
    '*\(ctrl+o to expand\)*'   # parens escaped: bare *( ) is an extglob operator
    '* · /*' '* · ~/*'
)

# Does $1 match any of the glob patterns in the remaining args? Pure bash.
_matches_any() {
    local s="$1" p
    shift
    for p in "$@"; do
        [[ "$s" == $p ]] && return 0
    done
    return 1
}

# This whole section is deliberately fork-free on the hot path: a frame redraws
# every couple of seconds, and a pipeline per worktree (grep, tr, $( )) costs
# far more than the git and lsof calls it surrounds.

# Pad or truncate $2 to exactly $3 columns, assigning to the variable named $1.
# Char-aware, not byte-aware -- printf '%-*s' pads by bytes and would misalign
# every row containing a multi-byte glyph.
_pad_v() {
    local s="$2" w="$3" n i out
    n=${#s}
    if (( n > w )); then
        out="${s:0:w-1}…"
    else
        out="$s"
        for (( i = n; i < w; i++ )); do out+=" "; done
    fi
    printf -v "$1" '%s' "$out"
}

# Terminal size: rows into the variable named $1, columns into $2.
#
# `tput cols` is wrong here: inside $( ) its stdout is a pipe, so it cannot
# ioctl the tty and silently falls back to terminfo's 80. For the same reason
# we must not gate this on [[ -t 1 ]] -- ask /dev/tty directly, and let the
# open fail (cron, pipes with no controlling tty) select the fallbacks.
_term_size_v() {
    local r="" c=""
    # The group's stderr is redirected because a failing `</dev/tty` open is
    # reported by the shell, not by stty -- `stty 2>/dev/null` would not hide
    # it. `|| true` keeps the empty-output read from tripping set -e.
    read -r r c < <({ stty size </dev/tty; } 2>/dev/null) || true
    [[ "$r" =~ ^[0-9]+$ ]] || r="${LINES:-40}"
    [[ "$c" =~ ^[0-9]+$ ]] || c="${COLUMNS:-100}"
    printf -v "$1" '%s' "$r"
    printf -v "$2" '%s' "$c"
}

# A horizontal rule $2 columns wide, assigned to the variable named $1.
_rule_v() {
    local w="$2" i out=""
    for (( i = 0; i < w; i++ )); do out+="─"; done
    printf -v "$1" '%s' "$out"
}

# Trim, strip agent line markers, squeeze runs of spaces. Pure bash.
_clean_line() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    s="${s#⏺ }"
    s="${s#⎿ }"
    s="${s#❯ }"
    s="${s#• }"
    s="${s#› }"
    while [[ "$s" == *"  "* ]]; do s="${s//  / }"; done
    printf -v CLEANED '%s' "$s"
}

# Is this line UI chrome rather than agent output? The chrome table plus the
# hint-bar strings that double as idle markers -- one source for both uses.
_is_chrome() {
    local l="$1" t="${1#"${1%%[![:space:]]*}"}"
    # Blank check as a glob *test*, never "${l//[[:space:]]/}": bash's global
    # substitution with a bracket expression is quadratic and costs ~700ms on a
    # 2KB pane, which is most of a refresh tick.
    [[ "$l" == *[![:space:]]* ]] || return 0
    _matches_any "$t" "${CHROME_PATTERNS[@]}" "${IDLE_MARKERS[@]}"
}

# Classify captured pane text against the marker tables above. Sets A_STATE
# and A_LINE.
#   A_STATE: input | working | idle | shell
_classify_pane() {
    local txt="$1" l
    A_STATE="shell"; A_LINE=""

    [[ "$txt" == *[![:space:]]* ]] || return 0

    # Order matters. A permission dialog also renders the hint bar, and the
    # working spinner also renders "for agents" -- so test most-specific first.
    if _matches_any "$txt" "${INPUT_MARKERS[@]}"; then
        A_STATE="input"
        # The question/reason line, if one is recognizable (Claude and Codex
        # phrasings); the last match wins, which favors Codex's "Reason:" line
        # over its generic "Would you like to..." question.
        while IFS= read -r l; do
            case "$l" in
                *"Do you want to"*|*"trust this folder"*|*Allow*|*Approve*) A_LINE="$l" ;;
                *"Would you like to"*|*"Do you trust"*)                     A_LINE="$l" ;;
            esac
        done <<< "$txt"
        if [[ -z "$A_LINE" ]]; then
            while IFS= read -r l; do
                case "${l#"${l%%[![:space:]]*}"}" in "❯ 1."*|"› 1."*) A_LINE="$l" ;; esac
            done <<< "$txt"
        fi
    elif _matches_any "$txt" "${WORKING_MARKERS[@]}"; then
        A_STATE="working"
        # The live status line: Claude's spinner "✢ Meandering… (4s · ↓ 65
        # tokens)" or Codex's "• Working (2s • esc to interrupt)".
        while IFS= read -r l; do
            case "$l" in *…*|*"• Working ("*) _is_chrome "$l" || A_LINE="$l" ;; esac
        done <<< "$txt"
        [[ -n "$A_LINE" ]] || A_LINE="working"
    elif _matches_any "$txt" "${IDLE_MARKERS[@]}"; then
        A_STATE="idle"
        while IFS= read -r l; do
            _is_chrome "$l" || A_LINE="$l"
        done <<< "$txt"
    fi

    _clean_line "$A_LINE"
    A_LINE="$CLEANED"
}

# Scrape a session's agent window. Sets A_STATE (plus "nosession") and A_LINE.
# $2 is session liveness ("1" = alive), which the caller already knows from its
# list-sessions snapshot -- re-asking tmux here would fork once per row per
# frame, and a second oracle could disagree with the TERM column mid-frame.
_agent_status() {
    local sess="$1" alive="${2:-}" txt
    A_STATE="nosession"; A_LINE=""

    [[ "$alive" == "1" ]] || return 0

    # Session is alive from here on, so any capture failure (no 'agent' window)
    # means "no agent", not "no session".
    A_STATE="shell"
    txt="$(tmux capture-pane -p -t "=$sess:agent" 2>/dev/null)" || return 0

    _classify_pane "$txt"
}

# Every listening TCP socket, tagged with the cwd of the process holding it.
# Emits "<cwd>\t<port>". Two lsof calls total.
#
# Note: we deliberately do NOT walk the process tree down from #{pane_pid} --
# dev servers (next-server, vite) reparent away from the pane's shell, so the
# tree walk misses them. cwd is what actually survives.
_ports_map() {
    local l pid addr uniq
    local pids=() ports=() cpid=() cwds=()

    while IFS= read -r l; do
        case "$l" in
            p*) pid="${l#p}" ;;
            n*) addr="${l#n}"
                case "$addr" in
                    *:[0-9]*) pids+=("$pid"); ports+=("${addr##*:}") ;;
                esac ;;
        esac
    done < <(lsof -nP -iTCP -sTCP:LISTEN -Fpn 2>/dev/null)

    (( ${#pids[@]} )) || return 0

    uniq="$(printf '%s\n' "${pids[@]}" | sort -u | paste -sd, -)"
    while IFS= read -r l; do
        case "$l" in
            p*) pid="${l#p}" ;;
            n*) cpid+=("$pid"); cwds+=("${l#n}") ;;
        esac
    done < <(lsof -a -d cwd -p "$uniq" -Fpn 2>/dev/null)

    local i j
    for (( i = 0; i < ${#pids[@]}; i++ )); do
        for (( j = 0; j < ${#cpid[@]}; j++ )); do
            if [[ "${pids[$i]}" == "${cpid[$j]}" ]]; then
                printf '%s\t%s\n' "${cwds[$j]}" "${ports[$i]}"
                break
            fi
        done
    done
}

# Builds the whole screen into $FRAME and the row->session map into $ROW_SESS.
# Not a subshell, because the attach keybinding needs $ROW_SESS to survive.
# $2 "true" clamps rows to the terminal height (the live repaint garbles if the
# frame scrolls); --once leaves it off so piped output is never truncated.
_status_frame() {
    local wide="$1" clamp="${2:-false}"
    FRAME=""
    ROW_SESS=()

    local repo_name wt_base cols lines outw w_branch fixed
    repo_name="$(get_repo_name)"
    wt_base="$WORKTREE_DIR/$repo_name"
    _term_size_v lines cols
    (( cols >= 40 )) || cols=40
    (( lines >= 10 )) || lines=10

    # Build the legend up front: the row clamp below needs to know whether it
    # renders as one line or two at this width. FRAME is its only output
    # channel, so borrow it and reset.
    local legend legend_h=1
    _legend_lines "$cols"
    legend="$FRAME"
    FRAME=""
    [[ "${legend%$'\n'}" == *$'\n'* ]] && legend_h=2

    # lsof reports physical cwds (macOS /tmp is a symlink to /private/tmp), so
    # a worktree base behind a symlink would never match a socket's cwd.
    # Resolve the base once per frame -- one fork -- and match rows both ways.
    local wt_real_base=""
    wt_real_base="$(CDPATH= cd -- "$wt_base" 2>/dev/null && pwd -P || true)"
    [[ "$wt_real_base" != "$wt_base" ]] || wt_real_base=""

    # Fit rows inside the terminal: the "! 1 " prefix is 4 columns and each
    # column gets one trailing space (the GIT trio shares one). Rows wider than
    # the terminal would wrap and garble the in-place repaint, so when OUTPUT
    # falls below its minimum, narrow BRANCH before giving up.
    w_branch=$W_BRANCH
    fixed=$(( 4 + w_branch + 1 + W_AGENT + 1 + W_INS + W_DEL + W_FILES + 1 + W_PORTS + W_TERM + 1 ))
    outw=$(( cols - 1 - fixed ))
    if (( outw < W_OUT_MIN )); then
        w_branch=$(( w_branch - (W_OUT_MIN - outw) ))
        (( w_branch >= 10 )) || w_branch=10
        fixed=$(( 4 + w_branch + 1 + W_AGENT + 1 + W_INS + W_DEL + W_FILES + 1 + W_PORTS + W_TERM + 1 ))
        outw=$(( cols - 1 - fixed ))
        (( outw >= W_OUT_MIN )) || outw=$W_OUT_MIN
    fi

    # lsof dwarfs everything else in a frame (routinely 100s of ms on macOS),
    # so the port map is cached and refreshed at most every PORTS_TTL seconds;
    # the 'r' key clears the cache for an immediate re-scan.
    if [[ -z "${PORTS_AT:-}" ]] || (( SECONDS - PORTS_AT >= PORTS_TTL )); then
        PORTS_MAP="$(_ports_map || true)"
        PORTS_AT=$SECONDS
    fi

    local pc=() pn=() cwd port
    while IFS=$'\t' read -r cwd port; do
        [[ -n "$cwd" && -n "$port" ]] || continue
        pc+=("$cwd"); pn+=("$port")
    done <<< "$PORTS_MAP"

    # Tab-delimited: a foreign session named with spaces would shift its
    # attached count into the name field on whitespace splitting. Session
    # names cannot contain tabs.
    local sn=() sa=() sname satt
    while IFS=$'\t' read -r sname satt; do
        sn+=("$sname"); sa+=("$satt")
    done < <(tmux list-sessions -F $'#{session_name}\t#{session_attached}' 2>/dev/null || true)

    local n_wt=0 n_sess=0 n_input=0 rows="" rowbuf=() idx=0
    local wt_dir branch_name sess i
    local c_branch c_agent c_ins c_del c_files c_ports c_att c_out

    while IFS=$'\t' read -r wt_dir branch_name; do
        n_wt=$(( n_wt + 1 ))
        sess="$(_resolve_session "$repo_name" "$wt_dir" "$branch_name")"

        # Session liveness and attached terminal count, both from the one
        # list-sessions snapshot -- the single source of truth for this frame,
        # so the STATE glyph and the TERM column can never contradict each other.
        local att="—" alive=""
        for (( i = 0; i < ${#sn[@]}; i++ )); do
            if [[ "${sn[$i]}" == "$sess" ]]; then
                alive=1
                n_sess=$(( n_sess + 1 ))
                if (( ${sa[$i]} > 0 )); then att="● ${sa[$i]}"; else att="○"; fi
                break
            fi
        done

        _agent_status "$sess" "$alive"
        _git_stats "$wt_dir"

        # ports whose cwd is this worktree or anywhere below it, matched
        # against the literal path and its physical twin under a symlinked base
        local plist="" wt_real=""
        [[ -n "$wt_real_base" ]] && wt_real="$wt_real_base/${wt_dir#"$wt_base"/}"
        for (( i = 0; i < ${#pc[@]}; i++ )); do
            if [[ "${pc[$i]}" == "$wt_dir" || "${pc[$i]}" == "$wt_dir"/* || \
                  ( -n "$wt_real" && ( "${pc[$i]}" == "$wt_real" || "${pc[$i]}" == "$wt_real"/* ) ) ]]; then
                case ",$plist," in
                    *",${pn[$i]},"*) ;;
                    *) plist="${plist:+$plist,}${pn[$i]}" ;;
                esac
            fi
        done

        local glyph agent_txt color
        case "$A_STATE" in
            input)   glyph="!"; agent_txt="needs input"; color="$YELLOW"; n_input=$(( n_input + 1 )) ;;
            working) glyph="●"; agent_txt="working";     color="$GREEN" ;;
            idle)    glyph="○"; agent_txt="idle";        color="$DIM" ;;
            shell)   glyph="·"; agent_txt="no agent";    color="$DIM" ;;
            *)       glyph=" "; agent_txt="no session";  color="$DIM" ;;
        esac
        [[ -n "$A_LINE" ]] || A_LINE="—"

        idx=$(( idx + 1 ))
        # Empty sentinel when there is no live session, so the 1-9 keybinding
        # ignores the row instead of exec-ing tmux attach at a ghost.
        if [[ "$A_STATE" == "nosession" ]]; then
            ROW_SESS+=("")
        else
            ROW_SESS+=("$sess")
        fi

        local num="  "
        (( idx <= 9 )) && num=" $idx"

        _pad_v c_branch "$branch_name" "$w_branch"
        _pad_v c_agent  "$agent_txt"   "$W_AGENT"
        _pad_v c_ins    "+$G_INS"      "$W_INS"
        _pad_v c_del    "-$G_DEL"      "$W_DEL"
        _pad_v c_files  "${G_FILES}f"  "$W_FILES"
        _pad_v c_ports  "${plist:-—}"  "$W_PORTS"
        _pad_v c_att    "$att"         "$W_TERM"
        _pad_v c_out    "$A_LINE"      "$outw"

        local row=""
        row+="${color}${glyph}${RESET}${DIM}${num}${RESET} "
        row+="${BOLD}${CYAN}${c_branch}${RESET} "
        row+="${color}${c_agent}${RESET} "
        row+="${GREEN}${c_ins}${RESET}${RED}${c_del}${RESET}${c_files} "
        row+="${BLUE}${c_ports}${RESET}${c_att} "
        row+="${DIM}${c_out}${RESET}"
        row+=$'\n'

        [[ "$wide" == "true" ]] && row+="   ${DIM}${wt_dir}${RESET}"$'\n'
        rowbuf+=("$row")
    done < <(_managed_worktrees "$wt_base")

    # Clamp rows to the terminal height: the fixed chrome is 6 lines (header,
    # two rules, column header, base path, key bar) plus the legend; anything
    # past that would scroll the screen and garble the cup-0-0 repaint. Every
    # row above was still *computed*, so the header counts stay accurate.
    local per_row=1 visible=$n_wt
    [[ "$wide" == "true" ]] && per_row=2
    if [[ "$clamp" == "true" ]]; then
        local data_lines=$(( lines - 6 - legend_h ))
        if (( n_wt * per_row > data_lines )); then
            # Reserve one line for the "… N more" indicator.
            visible=$(( (data_lines - 1) / per_row ))
            (( visible >= 1 )) || visible=1
        fi
    fi
    for (( i = 0; i < visible; i++ )); do
        rows+="${rowbuf[$i]}"
    done
    (( visible >= n_wt )) || \
        rows+=" ${DIM}… $(( n_wt - visible )) more — enlarge the terminal to see all${RESET}"$'\n'

    local rule clock
    _rule_v rule $(( cols - 1 ))

    # Cached without the clock, so the live loop can repaint line 0 every second
    # without rebuilding the (git + lsof + tmux) data behind it.
    HDR_TEXT="muxtree ── ${repo_name} ── ${n_wt} worktrees · ${n_sess} sessions"
    (( n_input > 0 )) && HDR_TEXT="$HDR_TEXT · ${n_input} need input"
    # The header shares its line with "   HH:MM:SS" (11 columns); truncate so
    # the once-per-second clock repaint can never wrap onto the rule line.
    (( ${#HDR_TEXT} <= cols - 12 )) || HDR_TEXT="${HDR_TEXT:0:cols-13}…"

    local h_b h_a h_g h_p h_t
    _pad_v h_b "BRANCH" "$w_branch"
    _pad_v h_a "AGENT"  "$W_AGENT"
    _pad_v h_g "GIT"    $(( W_INS + W_DEL + W_FILES ))
    _pad_v h_p "PORTS"  "$W_PORTS"
    _pad_v h_t "TERM"   "$W_TERM"

    clock="$(date +%H:%M:%S)"
    FRAME+="${BOLD}${HDR_TEXT}${RESET}${DIM}   ${clock}${RESET}"$'\n'
    FRAME+="${DIM}${rule}${RESET}"$'\n'
    FRAME+="${DIM}    ${h_b} ${h_a} ${h_g} ${h_p}${h_t} OUTPUT${RESET}"$'\n'

    if (( n_wt == 0 )); then
        FRAME+=$'\n'"  No managed worktrees. Use ${BOLD}muxtree new <branch>${RESET} to create one."$'\n'
    else
        FRAME+="$rows"
    fi

    FRAME+="${DIM}${rule}${RESET}"$'\n'
    FRAME+="${DIM} ${wt_base}${RESET}"$'\n'
    FRAME+="$legend"
}

# Explains the state glyph (column 1) and the TERM column. Appends to FRAME.
# Single line when there is room, stacked when narrow, so it never wraps.
_legend_lines() {
    local cols="$1"

    # Measure the plain text; the escapes in the rendered form are zero-width.
    local state_plain="STATE: ! needs input  ● working  ○ idle  · no agent  ␣ no session"
    local term_plain="TERM: ● n attached  ○ detached  — no session"

    local state="${DIM}STATE:${RESET} ${YELLOW}!${RESET} needs input  ${GREEN}●${RESET} working  ${DIM}○ idle  · no agent  ␣ no session${RESET}"
    local term="${DIM}TERM: ● n attached  ○ detached  — no session${RESET}"

    if (( cols >= ${#state_plain} + ${#term_plain} + 4 )); then
        FRAME+=" ${state}   ${term}"$'\n'
    else
        FRAME+=" ${state}"$'\n'
        FRAME+=" ${term}"$'\n'
    fi
}

_status_cleanup() {
    printf '\033[?7h'   # re-enable autowrap
    tput cnorm 2>/dev/null || true
    tput rmcup 2>/dev/null || true
}

cmd_status() {
    local interval="$STATUS_DEFAULT_INTERVAL" once=false wide=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --once|-1)     once=true; shift ;;
            --wide|-l)     wide=true; shift ;;
            --interval|-n)
                # An explicit check: a bare `shift 2` on a missing value fails
                # under set -e and would exit silently before the die below.
                [[ $# -ge 2 ]] || die "$1 requires a value (seconds)"
                interval="$2"; shift 2 ;;
            -*)            die "Unknown option: $1" ;;
            *)             die "Unexpected argument: $1" ;;
        esac
    done

    [[ "$interval" =~ ^[0-9]+$ ]] && (( interval > 0 )) \
        || die "--interval must be a positive integer (seconds)"

    ensure_git_repo
    load_config

    command -v tmux >/dev/null 2>&1 || die "tmux is required for muxtree status"

    # Non-interactive stdout (pipe, redirect) => single frame, no alt screen.
    # Same when there is no controlling tty (cron, wrappers that close stdin):
    # keys are read from /dev/tty -- stdin may be redirected, and a `read -t 1`
    # on a closed stdin would return EOF instantly and busy-loop at 100% CPU.
    [[ -t 1 ]] || once=true
    { : </dev/tty; } 2>/dev/null || once=true

    if $once; then
        _status_frame "$wide"
        printf '%s' "$FRAME"
        return 0
    fi

    # EXIT restores the terminal on every path; INT/TERM must *exit* -- a trap
    # that only cleaned up would leave the loop repainting over the normal
    # screen after Ctrl-C, since a trapped signal does not stop the script.
    trap '_status_cleanup' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    tput smcup 2>/dev/null || true
    tput civis 2>/dev/null || true
    # Autowrap off: an over-wide line (double-width CJK in agent output, a
    # terminal narrower than the columns can shrink) truncates at the right
    # edge instead of wrapping and shifting every row below it out of place.
    printf '\033[?7l'

    local sel="" key line clock last_clock="" last_build=0 due=1 misses=0

    # The clock ticks once a second; the table rebuilds every $interval. Keeping
    # them separate means the seconds advance smoothly even at -n 5, and a slow
    # rebuild never makes the clock stutter.
    #
    # bash 3.2 has no fractional `read -t`, so 1s is the finest poll available --
    # which is exactly the clock's resolution anyway.
    SECONDS=0
    while true; do
        if (( due )); then
            _status_frame "$wide" true
            tput cup 0 0 2>/dev/null || true
            while IFS= read -r line; do
                printf '%s\033[K\n' "$line"
            done <<< "${FRAME%$'\n'}"
            printf '%s\033[K' "${DIM} q quit · r refresh · 1-9 attach${RESET}"
            printf '\033[J'
            last_clock="$(date +%H:%M:%S)"
            last_build=$SECONDS
            due=0
        else
            # Repaint line 0 only -- no git, no lsof, no tmux. bash 3.2 (stock
            # macOS) has no printf '%()T', so the clock forks `date` -- once a
            # second, which is noise next to the frame rebuilds it avoids.
            clock="$(date +%H:%M:%S)"
            if [[ "$clock" != "$last_clock" ]]; then
                printf '\033[H%s%s%s%s   %s%s\033[K' \
                    "$BOLD" "$HDR_TEXT" "$RESET" "$DIM" "$clock" "$RESET"
                last_clock="$clock"
            fi
        fi

        key=""
        if read -rsn1 -t 1 key </dev/tty 2>/dev/null; then
            misses=0
            case "$key" in
                q|Q) break ;;
                r|R) PORTS_AT=""; due=1 ;;
                [1-9])
                    if (( key <= ${#ROW_SESS[@]} )) \
                       && [[ -n "${ROW_SESS[$(( key - 1 ))]}" ]]; then
                        sel="${ROW_SESS[$(( key - 1 ))]}"
                        break
                    fi ;;
            esac
        elif (( $? > 128 )); then
            # >128 is the 1s timeout expiring -- the normal idle path.
            misses=0
        else
            # <=128 means /dev/tty itself failed. The startup check caught a
            # missing tty; this catches one that disappears mid-run, where each
            # failed read returns instantly and the loop would otherwise spin
            # at 100% CPU -- the busy-loop the /dev/tty switch exists to fix.
            misses=$(( misses + 1 ))
            (( misses < 10 )) || break
        fi

        (( SECONDS - last_build >= interval )) && due=1
    done

    _status_cleanup
    trap - EXIT INT TERM

    if [[ -n "$sel" ]]; then
        _attach_session "$sel"
    fi
}

# ── Help ──────────────────────────────────────────────────────────────────────

cmd_help() {
    logo
    echo -e "

${BOLD}USAGE${RESET}
    muxtree <command> [options]

${BOLD}COMMANDS${RESET}
    ${CYAN}init${RESET}                              Set up global config (~/.muxtree/config)
        --local                       Create project config (.muxtree in repo root)
    ${CYAN}config${RESET}                            Show current config (global + project)

    ${CYAN}new${RESET} <branch> [options]             Create worktree + tmux session
        --from <branch>               Base branch (default: main/master)
        --checkout, -c                Adopt an existing local/remote branch
                                      (tracks it; push goes to the real branch)
        --run <claude|codex>          Auto-run command in agent window
        --prompt|-p <text>            Prompt to pass to the agent (requires --run)
        --bg                          Create session without opening terminal

    ${CYAN}list${RESET}                              List worktrees, diff stats, session status

    ${CYAN}status${RESET} [options]                  Live status pane (top-style), refreshes in place
        --once, -1                    Print one frame and exit (also when piped)
        --interval, -n <secs>         Refresh interval (default: 2)
        --wide, -l                    Show the full worktree path under each row

    ${CYAN}delete${RESET} <branch> [--force]          Delete worktree and branch (with confirmation)

    ${CYAN}sessions${RESET} <action> <branch> [opts]  Manage tmux session for a worktree
        open   <branch> [--run cmd]   Open terminal (creates session if needed)
               [--prompt "..."]
        close  <branch>               Kill tmux session
        relaunch <branch> [--run cmd] Close + reopen session
               [--prompt "..."]
        attach <branch> [dev|agent]   Attach to session (optionally select window)

    ${CYAN}help${RESET}                              Show this help message

${BOLD}EXAMPLES${RESET}
    muxtree init                          # Global setup
    muxtree init --local                  # Project-specific copy_files
    muxtree new feature-auth              # New worktree from main
    muxtree new fix-bug --from develop    # New worktree from develop
    muxtree new pr-branch --checkout      # Adopt an existing branch (PR review)
    muxtree new feature-ai --run claude   # Auto-launch claude code
    muxtree new fix-bug --run claude \\
      --prompt "fix the login bug"        # Launch claude with a prompt
    muxtree new fix-bug --bg              # Create without opening terminals
    muxtree list                          # Show all worktrees + status
    muxtree status                        # Live pane: agent state, ports, git
    muxtree status --once                 # One frame (scriptable)
